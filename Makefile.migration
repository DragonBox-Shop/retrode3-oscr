# Separate migration-only tests; does not compile or replace the existing OSCR CLI.
CXX ?= c++
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Werror -pedantic -O2
.PHONY: test-read-bus clean-migration
test-read-bus:
	mkdir -p build/migration
	$(CXX) $(CXXFLAGS) -I. -Iinclude src/retrode3/read_bus.cpp tests/read_bus_test.cpp -o build/migration/read_bus_test
	./build/migration/read_bus_test
clean-migration:
	rm -rf build/migration

.PHONY: test-readtest
test-readtest:
	python3 -m unittest discover -s tests -p 'test_readtest.py' -v

# Build a first native Linux executable from ORIGINAL pinned OSCR SNES C++
# bank-reading functions. This is NOT yet the complete upstream C++ core.
# The generator refuses unknown upstream changes and never edits the submodule.
NATIVE_CXXFLAGS = -std=c++11 -Wall -Wextra -Werror -pedantic -O2
NATIVE_HOST_SOURCES = src/retrode3/read_bus.cpp src/retrode3/oscr_snes_native.cpp src/retrode3/oscr_snes_posix.cpp src/retrode3/ndjson_protocol.cpp
NATIVE_INCLUDES = -I. -Iinclude
SNES_CORE_ARCHIVE = build/migration/liboscr-snes-core.a

build/migration/oscr_snes_banks.cpp: tools/build-linux-snes-core.py third_party/oscr-firmware/src/cores/SNES.cpp
	python3 tools/build-linux-snes-core.py --output $@

# The OSCR cartridge core is now its own linkable static library, separate
# from our CLI and kernel adapter. Future console cores get their own archives.
build/migration/oscr_snes_banks.o: build/migration/oscr_snes_banks.cpp include/retrode3/oscr_snes_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -c $< -o $@

$(SNES_CORE_ARCHIVE): build/migration/oscr_snes_banks.o
	$(AR) rcs $@ $<

.PHONY: native-snes test-native-snes
native-snes: $(SNES_CORE_ARCHIVE)
	$(CC) -std=gnu11 -O2 -I. -c retrode3-lib.c -o build/migration/retrode3-lib.o
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) $(NATIVE_HOST_SOURCES) build/migration/retrode3-lib.o $(SNES_CORE_ARCHIVE) -o build/migration/oscr-snes-native

test-native-snes: $(SNES_CORE_ARCHIVE)
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) $(NATIVE_HOST_SOURCES) tests/mock_snes_kernel.cpp $(SNES_CORE_ARCHIVE) -o build/migration/oscr-snes-native-mock
	python3 -m unittest discover -s tests -p 'test_python34_compat.py' -v
	python3 -m unittest discover -s tests -p 'test_native_snes.py' -v

# Partial native C++ MegaDrive stage. Only standard read-only linear ROMs.
MD_CORE_ARCHIVE = build/migration/liboscr-md-core.a

build/migration/oscr_md_core.cpp: tools/build-linux-md-core.py third_party/oscr-firmware/src/cores/MegaDrive.cpp
	python3 tools/build-linux-md-core.py --output $@

build/migration/oscr_md_core.o: build/migration/oscr_md_core.cpp include/retrode3/oscr_md_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -c $< -o $@

$(MD_CORE_ARCHIVE): build/migration/oscr_md_core.o
	$(AR) rcs $@ $<

.PHONY: test-md-save-layout
test-md-save-layout:
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) tests/md_save_layout_test.cpp -o build/migration/md_save_layout_test
	./build/migration/md_save_layout_test

.PHONY: native-md test-native-md
native-md: $(MD_CORE_ARCHIVE)
	$(CC) -std=gnu11 -O2 -I. -c retrode3-lib.c -o build/migration/retrode3-lib.o
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) src/retrode3/read_bus.cpp src/retrode3/oscr_md_stage1.cpp src/retrode3/oscr_md_native.cpp build/migration/retrode3-lib.o $(MD_CORE_ARCHIVE) -o build/migration/oscr-md-native

test-native-md: $(MD_CORE_ARCHIVE)
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) src/retrode3/read_bus.cpp src/retrode3/oscr_md_stage1.cpp src/retrode3/oscr_md_native.cpp tests/mock_md_kernel.cpp $(MD_CORE_ARCHIVE) -o build/migration/oscr-md-native-mock
	python3 -m unittest discover -s tests -p 'test_python34_compat.py' -v
	python3 -m unittest discover -s tests -p 'test_native_md.py' -v

# Shared-host MegaDrive adapter: generated original OSCR readWord/name C++,
# same physically verified MD_MODE_ROM bulk reader, shared host owns NDJSON,
# progress, CRC32, output and cancel. Only standard <= 4 MiB linear ROMs.
build/migration/oscr_md_core.pic.o: build/migration/oscr_md_core.cpp include/retrode3/oscr_md_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC $(NATIVE_INCLUDES) -c $< -o $@

.PHONY: native-md-module test-native-md-module stage-md-module
native-md-module: build/migration/oscr_md_core.pic.o
	$(CC) -std=gnu11 -O2 -fPIC -I. -c retrode3-lib.c -o build/migration/retrode3-lib.pic.o
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_md_stage1.cpp \
		src/retrode3/oscr_md_adapter.cpp build/migration/retrode3-lib.pic.o \
		build/migration/oscr_md_core.pic.o -o build/migration/md.so

# Run real original-OSCR adapter against a mocked MD kernel and compare its
# bytes to the prior hardware-proven standalone acceptance reader.
test-native-md-module: build/migration/oscr_md_core.pic.o test-native-md test-core-registry test-md-save-layout
	mkdir -p build/migration/real-md-fixture
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_md_stage1.cpp \
		src/retrode3/oscr_md_adapter.cpp tests/mock_md_kernel.cpp \
		build/migration/oscr_md_core.pic.o -o build/migration/real-md-fixture/md.so
	python3 -m unittest discover -s tests -p 'test_real_md_adapter.py' -v

# Image staging never installs or enables a core on the live Retrode3.
stage-md-module: native-md-module
	mkdir -p build/migration/stage/usr/lib/retrode3/cores-available
	install -m 644 build/migration/md.so build/migration/stage/usr/lib/retrode3/cores-available/md.so
	install -m 644 packaging/cores/md.core build/migration/stage/usr/lib/retrode3/cores-available/md.core

# Isolated MMC1 control-sequence planner: no kernel/GPIO linkage, no
# executable MMC1 cartridge writes, and no production-core feature exposure.
.PHONY: test-nes-mmc1-plan
test-nes-mmc1-plan:
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) \
		src/retrode3/nes_mmc1_plan.cpp tests/nes_mmc1_plan_test.cpp \
		-o build/migration/nes_mmc1_plan_test
	./build/migration/nes_mmc1_plan_test

# Stage-1 NES NROM: original pinned Sanni dumpBankPRG/CHR loops only,
# with reviewed 512-byte read-only HAL substitution for per-byte AVR calls.
# A pinned OSCR mapper-0 fingerprint catalog uniquely identifies ROM layout.
# Never guess size; never issue mapper, SRAM, EEPROM or flash writes.
build/migration/oscr_nes_nrom.cpp: tools/build-linux-nes-core.py third_party/oscr-firmware/src/cores/NES.cpp
	python3 tools/build-linux-nes-core.py --output $@

build/migration/oscr_nes_nrom.pic.o: build/migration/oscr_nes_nrom.cpp include/retrode3/oscr_nes_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC $(NATIVE_INCLUDES) -c $< -o $@

.PHONY: verify-nes-mapper-sequences
verify-nes-mapper-sequences:
	python3 tools/verify-nes-mapper-sequences.py

.PHONY: native-nes-module test-native-nes-module stage-nes-module
native-nes-module: verify-nes-mapper-sequences build/migration/oscr_nes_nrom.pic.o
	$(CC) -std=gnu11 -O2 -fPIC -I. -c retrode3-lib.c -o build/migration/retrode3-lib.pic.o
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_nes_posix.cpp \
		src/retrode3/oscr_nes_stage1.cpp src/retrode3/oscr_nes_catalog.cpp \
		src/retrode3/oscr_nes_mmc1_catalog.cpp \
		src/retrode3/oscr_nes_mapper.cpp src/retrode3/nes_mmc1_plan.cpp \
		src/retrode3/oscr_nes_adapter.cpp build/migration/retrode3-lib.pic.o \
		build/migration/oscr_nes_nrom.pic.o -o build/migration/nes.so

test-native-nes-module: test-nes-mmc1-plan verify-nes-mapper-sequences build/migration/oscr_nes_nrom.pic.o test-core-registry
	mkdir -p build/migration/real-nes-fixture
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs -DRETRODE3_TESTING $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_nes_posix.cpp \
		src/retrode3/oscr_nes_stage1.cpp src/retrode3/oscr_nes_catalog.cpp \
		src/retrode3/oscr_nes_mmc1_catalog.cpp \
		src/retrode3/oscr_nes_mapper.cpp src/retrode3/nes_mmc1_plan.cpp \
		src/retrode3/oscr_nes_adapter.cpp tests/mock_nes_kernel.cpp \
		build/migration/oscr_nes_nrom.pic.o -o build/migration/real-nes-fixture/nes.so
	mkdir -p build/migration/real-nes-production-fixture
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_nes_posix.cpp \
		src/retrode3/oscr_nes_stage1.cpp src/retrode3/oscr_nes_catalog.cpp \
		src/retrode3/oscr_nes_mmc1_catalog.cpp \
		src/retrode3/oscr_nes_mapper.cpp src/retrode3/nes_mmc1_plan.cpp \
		src/retrode3/oscr_nes_adapter.cpp tests/mock_nes_kernel.cpp \
		build/migration/oscr_nes_nrom.pic.o -o build/migration/real-nes-production-fixture/nes.so
	python3 -m unittest discover -s tests -p 'test_python34_compat.py' -v
	python3 -m unittest discover -s tests -p 'test_real_nes_adapter.py' -v
	python3 -m unittest discover -s tests -p 'test_nes_mapper_banks.py' -v

# Deliberate operator-only MMC1 lab experiment. This is NEVER staged to
# Debian packages or copied into the normal running installation.
# Intended ONLY for manually confirmed Rad Racer SGROM (128K PRG / CHR-RAM /
# NO PRG-WRAM). A separate runtime opt-in is required even with this build.
.PHONY: native-nes-mmc1-lab
native-nes-mmc1-lab: verify-nes-mapper-sequences build/migration/oscr_nes_nrom.pic.o
	mkdir -p build/migration/mmc1-lab
	$(CC) -std=gnu11 -O2 -fPIC -I. -c retrode3-lib.c -o build/migration/mmc1-lab/retrode3-lib.pic.o
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs -DRETRODE3_NES_MMC1_LAB $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_nes_posix.cpp \
		src/retrode3/oscr_nes_stage1.cpp src/retrode3/oscr_nes_catalog.cpp \
		src/retrode3/oscr_nes_mmc1_catalog.cpp \
		src/retrode3/oscr_nes_mapper.cpp src/retrode3/nes_mmc1_plan.cpp \
		src/retrode3/oscr_nes_adapter.cpp build/migration/mmc1-lab/retrode3-lib.pic.o \
		build/migration/oscr_nes_nrom.pic.o -o build/migration/mmc1-lab/nes.so

# Offline image staging, never a live install or default enablement.
stage-nes-module: native-nes-module
	mkdir -p build/migration/stage/usr/lib/retrode3/cores-available
	install -m 644 build/migration/nes.so build/migration/stage/usr/lib/retrode3/cores-available/nes.so
	install -m 644 packaging/cores/nes.core build/migration/stage/usr/lib/retrode3/cores-available/nes.core

# Core discovery is in the COMMON host, not individual OSCR core libraries.
# Static .a acceptance libraries are NOT listed as installable modules here.
# The real CLI uses root-owned cores-available / cores-enabled directories, while the
# TEST-only binary allows a fixture directory to exercise installation.
# Compile the shared CLI and corectl only if their real inputs changed.
# Convenience/test targets remain PHONY, but do not contain compiler recipes.
# In particular, running each of 30 core test targets must not rebuild the CLI.
REGISTRY_CLI_SOURCES = src/retrode3/retrode3_cli.cpp src/retrode3/ndjson_protocol.cpp
REGISTRY_CLI_HEADERS = include/retrode3/core_descriptor_v1.h \
	include/retrode3/core_operations_v1.h include/retrode3/core_operations_v2.h \
	include/retrode3/core_operations_v3.h include/retrode3/json_v3.h \
	include/retrode3/ndjson_protocol.h include/retrode3/hardware_scope_v1.h

build/migration/retrode3-cli: $(REGISTRY_CLI_SOURCES) $(REGISTRY_CLI_HEADERS)
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) $(REGISTRY_CLI_SOURCES) -ldl -o $@

build/migration/retrode3-corectl: src/retrode3/retrode3_corectl.cpp
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) $< -o $@

build/migration/retrode3-cli-mock: $(REGISTRY_CLI_SOURCES) $(REGISTRY_CLI_HEADERS)
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -DRETRODE3_TESTING $(REGISTRY_CLI_SOURCES) -ldl -o $@

build/migration/retrode3-corectl-mock: src/retrode3/retrode3_corectl.cpp
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) -DRETRODE3_TESTING $< -o $@

build/migration/registry-fixtures/snes.so: tests/mock_core_module.cpp \
	include/retrode3/core_descriptor_v1.h include/retrode3/core_operations_v1.h
	mkdir -p build/migration/registry-fixtures
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -fPIC -shared -DRETRODE3_MOCK_OPERATIONS $< -o $@

build/migration/registry-fixtures/md.so: tests/mock_core_module.cpp \
	include/retrode3/core_descriptor_v1.h include/retrode3/core_operations_v1.h
	mkdir -p build/migration/registry-fixtures
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -fPIC -shared -DRETRODE3_MOCK_ID='"md"' -DRETRODE3_MOCK_NAME='"Mega Drive"' -DRETRODE3_MOCK_SLOT='"md"' $< -o $@

build/migration/registry-fixtures/bad.so: tests/mock_core_module.cpp \
	include/retrode3/core_descriptor_v1.h
	mkdir -p build/migration/registry-fixtures
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -fPIC -shared -DRETRODE3_MOCK_ID='"bad"' -DRETRODE3_MOCK_ABI=99 $< -o $@

.PHONY: native-core-registry test-core-registry
native-core-registry: build/migration/retrode3-cli build/migration/retrode3-corectl

test-core-registry: native-core-registry \
	build/migration/retrode3-cli-mock build/migration/retrode3-corectl-mock \
	build/migration/registry-fixtures/snes.so \
	build/migration/registry-fixtures/md.so \
	build/migration/registry-fixtures/bad.so
	python3 -m unittest discover -s tests -p 'test_core_registry.py' -v
	python3 -m unittest discover -s tests -p 'test_shared_core_host.py' -v
	python3 -m unittest discover -s tests -p 'test_core_registry_incremental.py' -v


# Stage-1 real, dynamically loadable SNES adapter from the original pinned
# OSCR C++ functions. This remains limited to standard LoROM / HiROM.
# Build PIC separately; never link the test/mock kernel into a release .so.
build/migration/oscr_snes_banks.pic.o: build/migration/oscr_snes_banks.cpp include/retrode3/oscr_snes_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC $(NATIVE_INCLUDES) -c $< -o $@

.PHONY: native-snes-module test-native-snes-module
native-snes-module: build/migration/oscr_snes_banks.pic.o
	$(CC) -std=gnu11 -O2 -fPIC -I. -c retrode3-lib.c -o build/migration/retrode3-lib.pic.o
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_snes_posix.cpp \
		src/retrode3/oscr_snes_adapter.cpp build/migration/retrode3-lib.pic.o \
		build/migration/oscr_snes_banks.pic.o -o build/migration/snes.so

test-native-snes-module: build/migration/oscr_snes_banks.pic.o test-native-snes test-core-registry
	mkdir -p build/migration/real-snes-fixture
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		src/retrode3/read_bus.cpp src/retrode3/oscr_snes_posix.cpp \
		src/retrode3/oscr_snes_adapter.cpp tests/mock_snes_kernel.cpp \
		build/migration/oscr_snes_banks.pic.o -o build/migration/real-snes-fixture/snes.so
	python3 -m unittest discover -s tests -p 'test_real_snes_adapter.py' -v


# Offline SD-image build can stage a released .so with its static metadata.
# Staging neither enables the core nor modifies the device's live filesystem.
.PHONY: stage-snes-module
stage-snes-module: native-snes-module
	mkdir -p build/migration/stage/usr/lib/retrode3/cores-available
	install -m 644 build/migration/snes.so build/migration/stage/usr/lib/retrode3/cores-available/snes.so
	install -m 644 packaging/cores/snes.core build/migration/stage/usr/lib/retrode3/cores-available/snes.core

# Combined offline acceptance; retains all original standalone readers.
.PHONY: test-three-core-host test-all-shared-cores stage-all-shared-cores
test-three-core-host:
	python3 -m unittest discover -s tests -p 'test_three_core_host.py' -v

test-all-shared-cores: test-native-snes-module test-native-md-module test-native-nes-module test-three-core-host test-generic-selection-v3 test-slot-autoprobe test-sms-md-module
stage-all-shared-cores: stage-snes-module stage-md-module stage-nes-module

# Stable Debian staging paths shared with the retrode3 OS/package repository.
# No automatic install, root actions, activation, postinst or SD writes.
.PHONY: stage-shared-host stage-retrode3-runtime test-release-stage
stage-shared-host: native-core-registry
	install -d -m 755 build/migration/stage/usr/bin build/migration/stage/usr/sbin
	install -m 755 build/migration/retrode3-cli build/migration/stage/usr/bin/retrode3-cli
	install -m 755 build/migration/retrode3-corectl build/migration/stage/usr/sbin/retrode3-corectl

stage-retrode3-runtime: stage-shared-host stage-all-shared-cores

test-release-stage: stage-retrode3-runtime
	python3 -m unittest discover -s tests -p 'test_release_stage.py' -v

# Generic hardware-free ABI v3: selection, title/layout ambiguity, safety.
# Keep this test target in CI even when no real cartridge fixture is available.
.PHONY: test-generic-selection-v3
test-generic-selection-v3: native-core-registry
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		tests/mock_core_v3.cpp -o build/migration/mock-core-v3.so
	python3 -m unittest discover -s tests -p 'test_generic_selection_v3.py' -v

# Two independent v3 adapters sharing one mock physical slot.
.PHONY: test-slot-autoprobe
test-slot-autoprobe: build/migration/retrode3-cli-mock
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		-DRETRODE3_TEST_MOCK_ID='"mock-a"' \
		-DRETRODE3_TEST_MOCK_NAME='"Adapter A"' \
		-DRETRODE3_TEST_MOCK_SLOT='"md"' \
		tests/mock_core_v3.cpp -o build/migration/mock-slot-a.so
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) \
		-DRETRODE3_TEST_MOCK_ID='"mock-z"' \
		-DRETRODE3_TEST_MOCK_NAME='"Adapter Z"' \
		-DRETRODE3_TEST_MOCK_SLOT='"md"' \
		tests/mock_core_v3.cpp -o build/migration/mock-slot-z.so
	python3 -m unittest discover -s tests -p 'test_slot_autoprobe.py' -v

# SMS-0007 Retrode2 adapter, 8-bit kernel mode 20, explicit read-only lab.
# Generate real pinned OSCR SMS.cpp size table and ROM bank/buffer loops.
# Only reviewed AVR-to-kernel and SD-to-host replacements; no CLI rebuild.
build/migration/oscr_sms_generated.stamp: tools/build-linux-sms-core.py third_party/oscr-firmware/src/cores/SMS.cpp \
    tools/build-linux-sms-catalog.py third_party/oscr-sms-db.json
	mkdir -p build/migration
	python3 tools/build-linux-sms-core.py --size-output build/migration/oscr_sms_size.h --read-output build/migration/oscr_sms_read.h
	python3 tools/build-linux-sms-catalog.py --output build/migration/oscr_sms_catalog.h
	touch $@

# Kept out of the default release staging and normal web auto-enable.
SMS_MD_HEADERS = include/retrode3/sms_header_v1.h include/retrode3/sms_rom_core_v1.h \
    include/retrode3/sms_md_transport_v1.h include/retrode3/sms_md_posix_v1.h \
    include/retrode3/core_descriptor_v1.h include/retrode3/core_operations_v1.h \
    include/retrode3/core_operations_v3.h
SMS_MD_SOURCES = src/retrode3/oscr_sms_md_adapter.cpp src/retrode3/sms_md_posix_v1.cpp

build/migration/sms-md.so: $(SMS_MD_SOURCES) $(SMS_MD_HEADERS) build/migration/oscr_sms_generated.stamp
	mkdir -p build/migration
	$(CXX) $(NATIVE_CXXFLAGS) -fPIC -shared -Wl,-z,defs $(NATIVE_INCLUDES) -Ibuild/migration \
	    $(SMS_MD_SOURCES) -o $@

.PHONY: native-sms-md-module test-sms-md-module stage-sms-md-module
native-sms-md-module: build/migration/sms-md.so

test-sms-md-module: native-sms-md-module
	python3 -m unittest discover -s tests -p 'test_sms_catalog_generator.py' -v
	python3 -m unittest discover -s tests -p 'test_sms_oscr_generator.py' -v
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -Ibuild/migration tests/sms_header_v1_test.cpp -o build/migration/sms_header_v1_test
	./build/migration/sms_header_v1_test
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -Ibuild/migration -DRETRODE3_TESTING \
	    tests/sms_md_test.cpp $(SMS_MD_SOURCES) -o build/migration/sms_md_test
	./build/migration/sms_md_test
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -Ibuild/migration -DRETRODE3_TESTING \
	    tests/sms_md_transport_test.cpp src/retrode3/sms_md_posix_v1.cpp \
	    -o build/migration/sms_md_transport_test
	./build/migration/sms_md_transport_test
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -Ibuild/migration -DRETRODE3_TESTING \
	    tests/sms_md_live_test.cpp $(SMS_MD_SOURCES) \
	    -o build/migration/sms_md_live_test
	./build/migration/sms_md_live_test
	RETRODE3_SMS_TEST_MODULE=build/migration/sms-md.so python3 tests/test_sms_md_json.py

# Stage only by explicit request. Never auto-install or enable on the device.
stage-sms-md-module: native-sms-md-module
	mkdir -p build/migration/stage/usr/lib/retrode3/cores-available
	install -m 644 build/migration/sms-md.so build/migration/stage/usr/lib/retrode3/cores-available/sms-md.so
	install -m 644 packaging/cores/sms-md.core build/migration/stage/usr/lib/retrode3/cores-available/sms-md.core
