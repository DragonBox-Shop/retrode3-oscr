# Separate migration-only tests; does not compile or replace the existing OSCR CLI.
CXX ?= c++
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Werror -pedantic -O2
.PHONY: test-read-bus clean-migration
test-read-bus:
	mkdir -p build/migration
	$(CXX) $(CXXFLAGS) -I. -Iinclude src/retrode3/read_bus.cpp tests/read_bus_test.cpp -o build/migration/read_bus_test
	./build/migration/read_bus_test
clean-migration:
	rm -rf build/migration

.PHONY: test-readtest
test-readtest:
	python3 -m unittest discover -s tests -p 'test_readtest.py' -v

# Build a first native Linux executable from ORIGINAL pinned OSCR SNES C++
# bank-reading functions. This is NOT yet the complete upstream C++ core.
# The generator refuses unknown upstream changes and never edits the submodule.
NATIVE_CXXFLAGS = -std=c++11 -Wall -Wextra -Werror -pedantic -O2
NATIVE_HOST_SOURCES = src/retrode3/read_bus.cpp src/retrode3/oscr_snes_native.cpp src/retrode3/ndjson_protocol.cpp
NATIVE_INCLUDES = -I. -Iinclude
SNES_CORE_ARCHIVE = build/migration/liboscr-snes-core.a

build/migration/oscr_snes_banks.cpp: tools/build-linux-snes-core.py third_party/oscr-firmware/src/cores/SNES.cpp
	python3 tools/build-linux-snes-core.py --output $@

# The OSCR cartridge core is now its own linkable static library, separate
# from our CLI and kernel adapter. Future console cores get their own archives.
build/migration/oscr_snes_banks.o: build/migration/oscr_snes_banks.cpp include/retrode3/oscr_snes_compat.h
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) -c $< -o $@

$(SNES_CORE_ARCHIVE): build/migration/oscr_snes_banks.o
	$(AR) rcs $@ $<

.PHONY: native-snes test-native-snes
native-snes: $(SNES_CORE_ARCHIVE)
	$(CC) -std=gnu11 -O2 -I. -c retrode3-lib.c -o build/migration/retrode3-lib.o
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) $(NATIVE_HOST_SOURCES) build/migration/retrode3-lib.o $(SNES_CORE_ARCHIVE) -o build/migration/oscr-snes-native

test-native-snes: $(SNES_CORE_ARCHIVE)
	$(CXX) $(NATIVE_CXXFLAGS) $(NATIVE_INCLUDES) $(NATIVE_HOST_SOURCES) tests/mock_snes_kernel.cpp $(SNES_CORE_ARCHIVE) -o build/migration/oscr-snes-native-mock
	python3 -m unittest discover -s tests -p 'test_native_snes.py' -v
